# Application Settings
APP_NAME=notification-orchestration-app
APP_ENV=development
APP_BASE_URL=
DEBUG=True
LOG_LEVEL=INFO
API_VERSION=v1

# Local ngrok (only one machine should use a reserved URL at a time)
NGROK_URL=https://your-subdomain.ngrok-free.app
NGROK_AUTHTOKEN=your-ngrok-authtoken

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
# Use your own database / Supabase pooler URL here
SUPABASE_DB_URL=postgresql://username:password@your-project.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://username:password@your-project.pooler.supabase.com:6543/postgres

# Redis
# Local uvicorn uses localhost; Docker worker/beat override this to redis://redis:6379/0 automatically
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=replace-with-a-real-secret
JWT_SECRET_KEY=replace-with-a-real-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
API_KEY_EXPIRATION_DAYS=90

# Rate Limiting
RATE_LIMIT_PER_USER_HOUR=100
RATE_LIMIT_PER_APP_MINUTE=10000
RATE_LIMIT_SYSTEM_MINUTE=1000000

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS SQS
SQS_EMAIL_QUEUE_URL=
SQS_SMS_QUEUE_URL=
SQS_WHATSAPP_QUEUE_URL=
SQS_SLACK_QUEUE_URL=
SQS_PUSH_QUEUE_URL=
SQS_VOICE_QUEUE_URL=
SQS_INAPP_QUEUE_URL=

# AWS S3
S3_BUCKET_NAME=
S3_ATTACHMENTS_PREFIX=attachments/
S3_TEMPLATES_PREFIX=templates/

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TEST_RECEIVER_PHONE=
TEST_RECEIVER_WHATSAPP_PHONE=

# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
SLACK_ACCESS_TOKEN=
SLACK_REFRESH_TOKEN=
SLACK_CHANNEL_ID=

# Firebase
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_PUBLIC_KEY=
FIREBASE_PRIVATE_KEY=

# Apple Push Notifications
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.app
APNS_KEY_PATH=
APNS_USE_SANDBOX=True

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=default-voice-id

# LLM
QWEN_API_KEY=
QWEN_MODEL=qwen.qwen3-next-80b-a3b
QWEN_MODEL_ID=qwen.qwen3-next-80b-a3b
MISTRAL_API_KEY=

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Features
ENABLE_DEDUPLICATION=True
ENABLE_SCHEDULED_DELIVERY=True
ENABLE_ANALYTICS=True
ENABLE_AUDIT_LOGGING=True

# Testing / Demo Mode
USE_MOCK_PROVIDERS=False

# Deduplication
DEDUP_TTL_SECONDS=600
DEDUP_CONTENT_HASH_TTL=300
DEDUP_USER_PER_TYPE_LIMIT=1

# Retry
RETRY_MAX_ATTEMPTS=3
RETRY_EXPONENTIAL_BASE=2
RETRY_INITIAL_DELAY_SECONDS=30
RETRY_MAX_DELAY_SECONDS=1800

# Retention
NOTIFICATION_CONTENT_RETENTION_DAYS=90
AUDIT_LOG_HOT_RETENTION_DAYS=30
AUDIT_LOG_WARM_RETENTION_DAYS=365

# Tenant API key for local testing
API_KEY=

# Agentic System
ANALYZER_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
ROUTER_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
CHROMA_PERSIST_DIR=./chroma_data
ML_BUCKET=
SAGEMAKER_PIPELINE=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
